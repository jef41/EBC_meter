	(text "Blue LED control board"
		(exclude_from_sim no)
		(at 14.224 27.432 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "547a5f96-c171-42a7-8e6f-15c5becd8bc7")
	)
	(text "C19 to keep slew in range & avoid overshoot (0.19V/µs)\nC17 to prevent oscillation because of capacitance\n\nRC time constant for input at 1kΩ:\n1kΩ × 100pF = 100ns\n\nSwitch LED on\nWait ~50µs for electrical settling (slew + a few time constants margin)\nWait further 2ms for LED thermal settling\nBegin ADC readings"
		(exclude_from_sim no)
		(at 114.046 43.434 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bfa2a182-9898-4c71-90cb-9013b6eec6e8")
	)
	(text "LED driver section \naiming for 800mV at non-inverting & 800mA current max.\nrelies on MCU enabling output one at a time red or blue to activate opamp"
		(exclude_from_sim yes)
		(at 13.208 17.018 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e3f91c10-fb2d-4959-991b-0af96b43a347")
	)
