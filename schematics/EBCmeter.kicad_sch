	(text "LED driver section\nVref could be simple GPIO 3V3\nRedSample goes high, supplies Vref & disables blue\nBlueSample goes high, supplies Vref & disables red\nrelies on MCU holding inputs low, with MCU disconnected LEDs dimly lit"
		(exclude_from_sim yes)
		(at 208.534 58.674 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "55a2326b-9a27-4c3d-b6b5-79a5b9fa6297")
	)
	(text "C2 to keep slew in range & avoid overshoot (0.19V/µs)\nC1 to prevent oscillation because of capacitance\n\nRC time constant for input at 1kΩ:\n1kΩ × 100pF = 100ns\n\nSwitch LED on\nWait ~50µs for electrical settling (slew + a few time constants margin)\nWait further 20-50ms for LED thermal settling\nBegin ADC readings"
		(exclude_from_sim no)
		(at 137.16 74.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7ca9e9d5-4337-4b59-b10c-b33c49e29d8c")
	)
	(text "0-819mv in\n0-819mA out"
		(exclude_from_sim no)
		(at 173.736 110.998 0)
		(effects
